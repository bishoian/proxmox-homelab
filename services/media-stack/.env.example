# Copy to .env on the Debian VM and replace these placeholders locally.
# Never commit the real .env file or share its contents.
VPN_SERVICE_PROVIDER=expressvpn
OPENVPN_USER=REPLACE_WITH_EXPRESSVPN_MANUAL_USERNAME
OPENVPN_PASSWORD=REPLACE_WITH_EXPRESSVPN_MANUAL_PASSWORD
SERVER_COUNTRIES=USA

# Bind SMB to the Debian VM's LAN address; do not use a public/WAN address.
SAMBA_BIND_IP=REPLACE_WITH_DEBIAN_LAN_ADDRESS
